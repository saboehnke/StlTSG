@model StlTSG.Models.AccountModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var base64 = "";
    if (Model.ProfileImage != null)
    {
        base64 = Convert.ToBase64String(Model.ProfileImage);
    }
    else
    {
        string path = Server.MapPath(Url.Content("~/Images/DefaultProfile.gif"));
        byte[] bytes = File.ReadAllBytes(path);
        base64 = Convert.ToBase64String(bytes);
    }
    var profileImage = String.Format("data:image/gif;base64,{0}", base64);
    var stripeAuthLink = string.Format("https://connect.stripe.com/oauth/authorize?response_type=code&client_id={0}&scope=read_write",
        System.Configuration.ConfigurationManager.AppSettings["StripeClientID"]);
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>CDAR</title>
</head>
<body>
    <div class="row">
        <div class="col-md-4">
            <div class="panel-body pad-top">
                <img id="profile-image" class="img-responsive" src="@profileImage" />
                @using (Html.BeginForm("ImageUpload", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    <input type="file" name="file" class="align-left" />
                    <button class="btn btn-default btn-xs align-right" type="submit"><span class="glyphicon glyphicon-upload"></span> Upload</button>
                }
                @if (TempData["ProfileImageError"] != null)
                {
                    <div class="alert alert-danger alert-dismissible pad-top" role="alert">
                        @TempData["ProfileImageError"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    </div>
                }
                else if (TempData["ProfileImageMessage"] != null)
                {
                    <div class="alert alert-success bold pad-top" role="alert">
                        @TempData["ProfileImageMessage"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    </div>
                }
            </div>
        </div>
        <div class="col-md-7">
            <div class="panel-body">
                @if (Model.IsEmailVerified)
                {
                    <h3>Account: <span class="green">VERIFIED <span class="glyphicon glyphicon-ok-circle" aria-hidden="true"></span></span></h3>
                }
                else
                {
                    <h3>Account: <span class="red">NOT VERIFIED <span class="glyphicon glyphicon-remove" aria-hidden="true"></span></span></h3>
                    <button class="btn btn-default" onclick="location.href='@Url.Action("SendValidationEmail", "Account", new { UserID = Model.UserID, Email = Model.Email })'">Resend Verification Email</button>
                    if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger bold" role="alert">
                            @TempData["Error"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        </div>
                    }
                    else if (TempData["VerificationEmailMessage"] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            @TempData["VerificationEmailMessage"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        </div>
                    }
                }

                @if (Model.Subscribed)
                {
                    <h3>Subscription: <span class="green">SUBSCRIBED <span class="glyphicon glyphicon-ok-circle" aria-hidden="true"></span></span></h3>
                    <button class="btn btn-danger" onclick="location.href='@Url.Action("Unsubscribe", "Account")'">Unsubscribe</button>
                }
                else
                {
                    <h3>Subscription: <span class="red">NOT SUBSCRIBED <span class="glyphicon glyphicon-remove" aria-hidden="true"></span></span></h3>
                    <a class="btn btn-success" href="@stripeAuthLink">Subscribe</a>
                }

                <div class="collapse-group">
                    <button class="btn btn-default cp-hidden pad-top pad-bottom">Change Password</button>
                    <div class="collapse">
                        @Html.Partial("ChangePasswordView", new ViewDataDictionary())
                    </div>
                    @if (TempData["ChangePasswordMessage"] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            @TempData["ChangePasswordMessage"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-1"></div>
    </div>
</body>
</html>