@model StlTSG.Models.ResetPasswordViewModel

@using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-3"></div>
        <div class="col-md-6">
            <div class="panel-body img-responsive text-center">
                <img src="~/Images/CDAR-Logo.png" />
            </div>
        </div>
        <div class="col-md-3"></div>
    </div>
    <div class="row">
        <div class="col-md-4"></div>
        <div class="col-md-4">
            <h3>Reset your password.</h3>
            @Html.HiddenFor(m => m.Email)
            @Html.HiddenFor(m => m.Code)
            @Html.TextBoxFor(m => m.Password, new { @class = "form-control", @placeholder = "Password", @id = "rePassword", @type = "password", @required = "required" })
            @Html.TextBoxFor(m => m.ConfirmPassword, new { @class = "form-control", @placeholder = "Confirm password", @id = "reConfirmPassword", @type = "password", @required = "required" })
            <button type="submit" class="btn btn-primary" value="Open Form">Reset</button>
            <button class="btn btn-default" type="button" onclick="ClearForgottenPassword();" id="dClearButton">Clear</button>
        </div>
        <div class="col-md-4"></div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
