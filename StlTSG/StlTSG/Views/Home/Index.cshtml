@model StlTSG.Models.InputFormModel

@{
    ViewBag.Title = "CDAR";
}

<body>
    <!--Contact modal-->
    <div class="modal fade" id="contact" role="dialog" name="modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="blue bold">CONTACT US</h4>
                </div>
                <div class="modal-body">
                    @using (Html.BeginForm("ContactUs", "Home", FormMethod.Post))
                    {
                        <div class="container">
                            <h4 class="bold">Send us a message:</h4>
                            <div class="col-md-3">
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = "Email", @id = "cEmail", @type = "email", @required = "required" })
                                @Html.TextAreaFor(m => m.Issue, new { @class = "form-control pad-bottom", @placeholder = "Message", @id = "cIssue", @rows = "2", @type = "text", @required = "required" })
                                <div class="help-block with-errors"></div>
                                <button type="submit" class="btn btn-primary" value="Open Form">Submit</button>
                                <button class="btn btn-default" data-dismiss="modal">Cancel</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Header -->
    <header id="top" class="header">
        <div class="text-vertical-center">
            <div class="row">
                <video poster="" id="bgvid" playsinline autoplay muted loop>
                    <source src="~/Images/bgvid1.mp4" type="video/mp4">
                </video>
                <div class="col-md-4">
                </div>
                <div class="col-md-4">
                    <h1 style="color:white">St. Louis Thermal Spray &amp; Grinding Logo</h1>
                    @*@Html.DropDownListFor(m => m.Institution, new SelectList(Model.Clients.Select(c => c.Name).ToList()), "Select Your Institution", new { @class = "btn-lg btn-inst form-control", @id = "institutionDropdown" })*@
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger bold" role="alert">
                            @TempData["Error"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        </div>
                    }
                    else if (TempData["RegisterAccountError"] != null)
                    {
                        <div class="alert alert-danger bold" role="alert">
                            @TempData["RegisterAccountError"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        </div>
                    }
                </div>
                <div class="col-md-4"></div>
            </div>
        </div>
    </header>

    <!-- Services -->
    <section id="services" class="services bg-purple">
        <div class="container">
            <div class="row text-center">
                <div class="col-lg-10 col-lg-offset-1">
                    <h2>Our Services</h2>
                    <hr class="small">
                    <div class="row">
                        <div class="col-md-3 col-sm-3">
                            <div class="service-item">
                                <span class="fa-stack fa-4x">
                                    <i class="fa fa-circle fa-stack-2x"></i>
                                    <i class="fa fa-briefcase fa-stack-1x purple"></i>
                                </span>
                                <h4>
                                    <strong>Service 1</strong>
                                </h4>
                                <p>Service 1 Description</p>
                                <a href="#" class="btn btn-light">Learn More</a>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-3">
                            <div class="service-item">
                                <span class="fa-stack fa-4x">
                                    <i class="fa fa-circle fa-stack-2x"></i>
                                    <i class="fa fa-wrench fa-stack-1x purple"></i>
                                </span>
                                <h4>
                                    <strong>Service 2</strong>
                                </h4>
                                <p>Service 2 Description</p>
                                <a href="#" class="btn btn-light">Learn More</a>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-3">
                            <div class="service-item">
                                <span class="fa-stack fa-4x">
                                    <i class="fa fa-circle fa-stack-2x"></i>
                                    <i class="fa fa-building fa-stack-1x purple"></i>
                                </span>
                                <h4>
                                    <strong>Service 3</strong>
                                </h4>
                                <p>Service 3 Description</p>
                                <a href="#" class="btn btn-light">Learn More</a>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-3">
                            <div class="service-item">
                                <span class="fa-stack fa-4x">
                                    <i class="fa fa-circle fa-stack-2x"></i>
                                    <i class="fa fa-calendar fa-stack-1x purple"></i>
                                </span>
                                <h4>
                                    <strong>Service 4</strong>
                                </h4>
                                <p>Service 4 Description</p>
                                <a href="#" class="btn btn-light">Learn More</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Callout -->
    <aside class="callout">
        <div class="text-vertical-center">
        </div>
    </aside>

    <aside id="diagnostics" class="call-to-action bg-default cover">
        <div class="container">
            <div class="row">
                <div class="col-md-3"></div>
                <div class="col-md-6">
                    @using (Html.BeginForm("DiagnosticRequest", "Home", FormMethod.Post))
                    {
                        <div class="form-group">
                            <h1 class="blue">Diagnostics Request:</h1>
                            @Html.DropDownListFor(m => m.Institution, new SelectList(Model.Clients.Select(c => c.Name).ToList()), "Select Your Institution", new { @class = "pad-bottom form-control", @id = "institutionDDropdown" })
                            @Html.HiddenFor(m => m.Institution, new { @id = "chosenDInstitution", @required = "required" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = "Email", @id = "dEmail", @type = "email", @required = "required" })
                            @Html.TextAreaFor(m => m.Issue, new { @class = "form-control", @placeholder = "Describe your issue...", @id = "dMessage", @rows = "5", @required = "required" })
                            <button class="btn btn-primary" type="submit" onclick="ValidateDRequestForm();" id="dSubmitButton">Submit</button>
                            <button class="btn btn-default" type="button" onclick="ClearDiagnostic();" id="dClearButton">Clear</button>
                        </div>
                    }
                </div>
                <div class="col-md-3"></div>
            </div>
        </div>
    </aside>

    <aside id="appointment" class="call-to-action bg-purple cover">
        <div class="container">
            <div class="row">
                <div class="col-md-3"></div>
                <div class="col-md-6">
                    @using (Html.BeginForm("AppointmentRequest", "Home", FormMethod.Post))
                    {
                        <div class="form-group">
                            <h1>Appointment Request:</h1>
                            @Html.DropDownListFor(m => m.Institution, new SelectList(Model.Clients.Select(c => c.Name).ToList()), "Select Your Institution", new { @class = "pad-bottom form-control", @id = "institutionADropdown" })
                            @Html.HiddenFor(m => m.Institution, new { @id = "chosenAInstitution", @required = "required" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = "Email", @id = "aEmail", @type = "email", @required = "required" })
                            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", @placeholder = "First Name", @id = "aFirstName", @required = "required" })
                            @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", @placeholder = "Last Name", @id = "aLastName", @required = "required" })
                            @Html.TextBoxFor(m => m.DeviceBrand, new { @class = "form-control", @placeholder = "Computer brand (ASUS, HP, Dell, etc.)", @id = "aBrand", @required = "required" })
                            @Html.TextBoxFor(m => m.DeviceModel, new { @class = "form-control", @placeholder = "Computer model (Bottom of computer or under battery)", @id = "aModel", @required = "required" })
                            @Html.TextAreaFor(m => m.Issue, new { @class = "form-control", @placeholder = "Describe your issue...", @id = "aMessage", @rows = "5", @required = "required" })
                            <button class="btn btn-primary" type="submit" onclick="ValidateARequestForm();" id="aSubmitButton">Submit</button>
                            <button class="btn btn-default" type="button" onclick="ClearAppointment();" id="aClearButton">Clear</button>
                        </div>
                    }
                </div>
                <div class="col-md-3"></div>
            </div>
        </div>
    </aside>

    <aside id="payments" class="call-to-action bg-default cover">
        <div class="container">
            <div class="row">
                <div class="col-md-3"></div>
                <div class="col-md-6">
                    @using (Html.BeginForm("Payment", "Home", FormMethod.Post))
                    {
                        <div class="form-group">
                            <h1 class="blue">Make a Payment:</h1>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = "Email", @id = "pEmail", @type = "email", @required = "required" })
                            <button class="btn btn-primary" type="submit" id="pSubmitButton">Submit</button>
                            <button class="btn btn-default" type="button" onclick="ClearPayment();" id="pClearButton">Clear</button>
                        </div>
                    }
                </div>
                <div class="col-md-3"></div>
            </div>
        </div>
    </aside>

    <footer>
        <div class="container">
            <div class="row">
                <div class="col-lg-10 col-lg-offset-1 text-center">
                    <hr class="small">
                    <p class="text-muted">Copyright &copy; St. Louis Thermal Spray and Grinding 2018</p>
                </div>
            </div>
        </div>
        <a id="to-top" href="#top" class="btn btn-dark btn-lg"><i class="fa fa-chevron-up fa-fw fa-1x"></i></a>
    </footer>
</body>
