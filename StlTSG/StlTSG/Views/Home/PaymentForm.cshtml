@model StlTSG.Models.PaymentForm
@{
    ViewBag.Title = "PaymentForm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string payBtnText = string.Format("Pay ${0}", Model.Amount);
    string amountOwedText = string.Format("Amount: ${0}", Model.Amount);
}

<div class="row">
    <div class="col-md-4"></div>
    <div class="col-md-4">
        <div class="panel-body img-responsive text-center">
            <img src="~/Images/CDAR-Logo.png" />
        </div>
    </div>
    <div class="col-md-4"></div>
</div>
<div class="row">
    <div class="col-md-4"></div>
    <div class="col-md-4">
        @using (Html.BeginForm("MakePayment", "Home", FormMethod.Post))
        {
            <h4>@amountOwedText</h4>
            @Html.HiddenFor(m => m.Amount);
            @Html.HiddenFor(m => m.Email);
            @Html.TextBoxFor(m => m.CardNumber, new { @class = "form-control", @placeholder = "Card number", @id = "cardNumber", @required = "required" })
            @Html.TextBoxFor(m => m.Expiration, new { @class = "form-control", @placeholder = "Expiration (MM/YYYY)", @id = "cardExpiration", @required = "required" })
            <button class="btn btn-primary" type="submit">@payBtnText</button>
            <button class="btn btn-default" onclick="ClearPaymentForm()">Clear</button>
        }
    </div>
    <div class="col-md-4"></div>
</div>