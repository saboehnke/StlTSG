@model StlTSG.Models.RegisterViewModel

<div class="row">
    <div class="col-md-4">
        @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
        {
            @Html.TextBoxFor(m => m.Password, new { @class = "form-control", @placeholder = "Password", @id = "cPassword", @type = "password", @required = "required" });
            @Html.TextBoxFor(m => m.ConfirmPassword, new { @class = "form-control", @placeholder = "Confirm password", @id = "cConfirmPassword", @type = "password", @required = "required" });
            <button class="btn btn-primary" type="submit" id="aSubmitButton">Submit</button>
            <button class="btn btn-default" type="button" onclick="ClearChangePassword();" id="aClearButton">Clear</button>
        }
    </div>
</div>