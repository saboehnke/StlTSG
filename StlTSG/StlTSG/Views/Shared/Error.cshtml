@model System.Web.Mvc.HandleErrorInfo

@{
    ViewBag.Title = "Error";
}

<div class="row">
    <div class="col-md-3"></div>
    <div class="col-md-6">
        <div class="panel-body img-responsive text-center">
            <img src="~/Images/CDAR-Logo.png" />
        </div>
    </div>
    <div class="col-md-3"></div>
</div>
<div class="row">
    <div class="col-md-3"></div>
    <div class="col-md-6">
        <h1 class="bold red">An error occurred...</h1>
        <h2 class="red">An error occurred while processing your request. Please contact us if this issue continues to happen.</h2>
    </div>
    <div class="col-md-3"></div>
</div>
<div class="row">
    <div class="col-md-3"></div>
    <div class="col-md-6">
        <h3 class="text-center">@Html.ActionLink("Click here to go to the main page.", "Index", "Home")</h3>
    </div>
    <div class="col-md-3"></div>
</div>