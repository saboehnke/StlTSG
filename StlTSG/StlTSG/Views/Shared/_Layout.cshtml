@{
    @RenderSection("scripts", required: false)
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">

    <link rel="shortcut icon" href="~/Images/CDAR-Icon.ico" />

    <title>St. Louis Thermal Spary and Grinding</title>

    <!-- Bootstrap Core CSS -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="~/Content/Site.css" rel="stylesheet">
    <link href="~/Content/css/calendar.css" rel="stylesheet">

    <!-- Custom Fonts -->
    <link href="~/Content/css/font-awesome.min.css" rel="stylesheet" type="text/css">
</head>
<body>
    <!-- Navigation -->
    <a id="menu-toggle" href="#" class="btn btn-dark btn-lg toggle"><i class="fa fa-bars"></i></a>
    <nav id="sidebar-wrapper">
        <ul class="sidebar-nav">
            <a id="menu-close" href="#" class="btn btn-light btn-lg pull-right toggle"><i class="fa fa-times"></i></a>
            @if (!((Request.Url.ToString().Contains("Dashboard/Dashboard")) || (Request.Url.ToString().Contains("Account/Account"))
                || (Request.Url.ToString().Contains("Home/"))))
            {
                <li class="sidebar-brand">
                    <a href="#top" onclick=$("#menu-close").click();>STL TSG</a>
                </li>
                <li>
                    <a href="#top" onclick=$("#menu-close").click();>Home</a>
                </li>
                <li>
                    <a href="#diagnostics" onclick=$("#menu-close").click();>Diagnostics</a>
                </li>
                <li>
                    <a href="#appointment" onclick=$("#menu-close").click();>Appointment</a>
                </li>
                <li>
                    <a href="#payments" onclick=$("#menu-close").click();>Payments</a>
                </li>
                <li>
                    <a href="#services" onclick=$("#menu-close").click();>Services</a>
                </li>
                <li>
                    <a href="#contact" onclick=$("#menu-close").click(); data-toggle="modal">Contact</a>
                </li>
            }
            else
            {
                <li class="sidebar-brand">
                    @Html.ActionLink("STL TSG", "Index", "Home", null, null, "top", null, null)
                </li>
                <li>
                    @Html.ActionLink("Home", "Index", "Home", null, null, "top", null, null)
                </li>
                <li>
                    @Html.ActionLink("Diagnostics", "Index", "Home", null, null, "diagnostics", null, null)
                </li>
                <li>
                    @Html.ActionLink("Appointment", "Index", "Home", null, null, "appointment", null, null)
                </li>
                <li>
                    @Html.ActionLink("Payments", "Index", "Home", null, null, "payments", null, null)
                </li>
                <li>
                    @Html.ActionLink("Services", "Index", "Home", null, null, "services", null, null)
                </li>
                <li>
                    <a href="#contact" onclick=$("#menu-close").click(); data-toggle="modal">Contact</a>
                </li>
            }
            <li><hr></li>
            @if (!User.Identity.IsAuthenticated)
            {
                <li>
                    <a href="#login" onclick=$("#menu-close").click(); data-toggle="modal">Login</a>
                </li>
                <li>
                    <a href="#register" onclick=$("#menu-close").click(); data-toggle="modal">Register</a>
                </li>
            }
            else
            {
                @Html.Partial("LogOffView", new ViewDataDictionary());
            }
        </ul>
    </nav>

    <div class="container-fluid body-content">
        @Html.Partial("LoginView", new ViewDataDictionary())
        @Html.Partial("RegisterView", new ViewDataDictionary())
        @RenderBody()
    </div>

    <!-- jQuery -->
    <script src="~/Scripts/jquery.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>

    <!-- Bootstrap Core JavaScript -->
    <script src="~/Scripts/bootstrap.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.12.0/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
    <script src="~/Scripts/UIHandler.js"></script>
    @if (Request.Url.ToString().Contains("Dashboard/Dashboard"))
    {
        <script src="~/Scripts/Dashboard.js"></script>
    }
    else if (Request.Url.ToString().Contains("Account/ResetPassword"))
    {
        <script src="~/Scripts/ResetPasswordForm.js"></script>
    }
    else if (Request.Url.ToString().Contains("Account/Account"))
    {
        <script src="~/Scripts/Account.js"></script>
    }
    @*<script src="~/Scripts/es6.js"></script>*@
</body>
</html>